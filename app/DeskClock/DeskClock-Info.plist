<plist version="1.0">
<dict>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>OFFICE_LATITUDE</key>
	<string>$(OFFICE_LATITUDE)</string>
	<key>OFFICE_LONGITUDE</key>
